  Field Naming Conventions

  Snake Case → Camel Case

  batch_consumers → batchConsumers (field name)
  batch_consumers → BatchConsumers (getter name)
  batch_consumers → getBatchConsumers() (getter method)

  Implementation

  private String toCamelCaseCapitalized(String snakeCase) {
    final var parts = snakeCase.split("_");
    final var result = new StringBuilder();
    for (final var part : parts) {
      if (!part.isEmpty()) {
        result.append(Character.toUpperCase(part.charAt(0)))
              .append(part.substring(1));
      }
    }
    return result.toString();
  }

