  Common JavaPoet Patterns

  Fields

  // With Lombok - no modifiers
  FieldSpec.builder(String.class, "fieldName").build()

  // Without Lombok - explicit modifiers
  FieldSpec.builder(String.class, "fieldName", Modifier.PRIVATE, Modifier.FINAL).build()

  Multi-Statement Method Bodies

  method.addStatement("final var mapper = new $T()", MapperClass.class);
  method.addStatement("return builder.props(data.stream().map(mapper::apply).collect($T.toList()))",
    Collectors.class);

  Importing Classes

